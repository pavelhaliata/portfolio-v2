---
import CursorGlow from '../components/CursorGlow/CursorGlow.astro'
import interRegularUrl from '../assets/fonts/inter/inter-regular.woff2?url'
import '../shared/style/reset.css'
import '../shared/style/fonts.css'
import '../shared/style/variables.css'
import './Layout.css'
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="preload"
      href={interRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <title>Pavel Haliata</title>
  </head>
  <body>
    <CursorGlow />
    <slot />
  </body>
</html>
