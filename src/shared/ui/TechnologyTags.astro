---
interface Props {
  items: string[]
}

const { items } = Astro.props
---

{items.length > 0 && (
  <ul class="technology-tags" role="list" aria-label="Используемые технологии">
    {items.map((technology) => (
      <li class="technology-tags__item">{technology}</li>
    ))}
  </ul>
)}

<style>
  .technology-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .technology-tags__item {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25rem;
  }
</style>
